          "a": { "ports": { "right": { "vessel": "mid", "side": "left" } } },
          "b": { "ports": { "left": { "vessel": "mid", "side": "right" } } },
          "mid": {
            "accepts": [{ "kind": "item", "type": "gem" }],
            "ports": {
              "right": { "vessel": "b", "side": "left" },
              "left": { "vessel": "a", "side": "right" }
            }
          }
        } },
        "vesselId": "mid",
        "bridged": { "from": { "vessel": "a", "side": "right" }, "to": { "vessel": "b", "side": "left" } }
