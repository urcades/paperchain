    {
      "id": "doll-connect-displaces",
      "rule": "paper-doll/v3#editing-operations",
      "subject": "paper-doll/v3",
      "operation": "connect",
      "input": { "args": [
        { "root": "a", "vessels": {
          "a": { "ports": { "right": { "vessel": "b", "side": "left" } } },
          "b": { "ports": { "left": { "vessel": "a", "side": "right" } } },
          "c": {}
        } },
        { "vessel": "a", "side": "right" },
        { "vessel": "c", "side": "left" }
      ] },
      "expected": { "outcome": "ok", "value": {
        "body": { "root": "a", "vessels": {
          "a": { "ports": { "right": { "vessel": "c", "side": "left" } } },
          "b": { "ports": {} },
          "c": { "ports": { "left": { "vessel": "a", "side": "right" } } }
        } },
        "displaced": [{ "from": { "vessel": "a", "side": "right" }, "to": { "vessel": "b", "side": "left" } }]
      } }
    },
