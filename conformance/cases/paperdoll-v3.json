      },
      "expected": { "outcome": "unresolved" }
    },
    {
      "id": "paperdoll-v3.resolve.well-formed-nested-without-body",
      "rule": "paper-doll/v3#addressing",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": { "root": "root", "vessels": { "root": { "contains": [{ "kind": "item", "id": "key" }] } } },
