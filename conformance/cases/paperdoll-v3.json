    },
    {
      "id": "paperdoll-v3.validate.one-way-port",
      "rule": "paper-doll/v3#law-2-reciprocity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "left",
            "vessels": {
              "left": { "ports": { "right": { "vessel": "right", "side": "left" } } },
              "right": {}
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.left.ports.right"]
      }
    },
    {
      "id": "paperdoll-v3.validate.non-opposite-port",
      "rule": "paper-doll/v3#law-3-opposition",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "left",
            "vessels": {
              "left": { "ports": { "right": { "vessel": "right", "side": "top" } } },
              "right": { "ports": { "top": { "vessel": "left", "side": "right" } } }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.left.ports.right", "$.body.vessels.right.ports.top"]
      }
    },
    {
      "id": "paperdoll-v3.validate.inconsistent-layout",
      "rule": "paper-doll/v3#law-4-planarity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "body",
            "vessels": {
              "body": { "ports": { "top": { "vessel": "head", "side": "bottom" }, "right": { "vessel": "arm", "side": "left" } } },
              "head": { "ports": { "bottom": { "vessel": "body", "side": "top" }, "right": { "vessel": "hand", "side": "left" } } },
              "arm": { "ports": { "left": { "vessel": "body", "side": "right" }, "bottom": { "vessel": "hand", "side": "top" } } },
              "hand": { "ports": { "left": { "vessel": "head", "side": "right" }, "top": { "vessel": "arm", "side": "bottom" } } }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.arm.ports.bottom"]
      }
    },
    {
      "id": "paperdoll-v3.validate.distinct-vessel-layout-collision",
      "rule": "paper-doll/v3#law-4-planarity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": { "ports": { "top": { "vessel": "a", "side": "bottom" }, "right": { "vessel": "b", "side": "left" } } },
              "a": { "ports": { "bottom": { "vessel": "root", "side": "top" }, "right": { "vessel": "x", "side": "left" } } },
              "b": { "ports": { "left": { "vessel": "root", "side": "right" }, "top": { "vessel": "y", "side": "bottom" } } },
              "x": { "ports": { "left": { "vessel": "a", "side": "right" } } },
              "y": { "ports": { "bottom": { "vessel": "b", "side": "top" } } }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.b.ports.top"]
      }
    },
    {
      "id": "paperdoll-v3.validate.consistent-square-cycle",
      "rule": "paper-doll/v3#law-4-planarity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": { "ports": { "top": { "vessel": "a", "side": "bottom" }, "right": { "vessel": "b", "side": "left" } } },
              "a": { "ports": { "bottom": { "vessel": "root", "side": "top" }, "right": { "vessel": "x", "side": "left" } } },
              "b": { "ports": { "left": { "vessel": "root", "side": "right" }, "top": { "vessel": "x", "side": "bottom" } } },
              "x": { "ports": { "left": { "vessel": "a", "side": "right" }, "bottom": { "vessel": "b", "side": "top" } } }
            }
          }
        }
      },
      "expected": { "outcome": "valid" }
    },
    {
      "id": "paperdoll-v3.validate.unreachable-ported-island",
      "rule": "paper-doll/v3#law-5-reachability",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": {},
              "island-a": { "ports": { "right": { "vessel": "island-b", "side": "left" } } },
              "island-b": { "ports": { "left": { "vessel": "island-a", "side": "right" } } }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.island-a", "$.body.vessels.island-b"]
      }
    },
    {
      "id": "paperdoll-v3.validate.open-vessel-accepts-anything",
      "rule": "paper-doll/v3#law-6-compatibility",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": { "root": { "contains": [{ "kind": "item", "type": "key", "id": "brass-key" }] } }
          }
        }
      },
      "expected": { "outcome": "valid" }
    },
    {
      "id": "paperdoll-v3.validate.sealed-vessel-rejects-element",
      "rule": "paper-doll/v3#law-6-compatibility",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": { "root": { "accepts": [], "contains": [{ "kind": "item", "id": "key" }] } }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.root.contains.0"]
      }
    },
    {
      "id": "paperdoll-v3.validate.compatible-typed-element",
      "rule": "paper-doll/v3#law-6-compatibility",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": {
                "accepts": [{ "kind": "item", "type": "key" }],
                "contains": [{ "kind": "item", "type": "key", "id": "brass-key" }]
              }
            }
          }
        }
      },
      "expected": { "outcome": "valid" }
    },
    {
      "id": "paperdoll-v3.validate.invalid-nested-body",
      "rule": "paper-doll/v3#law-7-recursive-validity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": {
                "contains": [{ "kind": "item", "id": "pack", "body": { "root": "missing", "vessels": {} } }]
              }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.root.contains.0.body.root"]
