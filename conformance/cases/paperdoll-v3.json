            "root": "left",
            "vessels": {
              "left": { "contains": [{ "kind": "item", "id": "coin" }] },
              "right": { "contains": [{ "kind": "item", "id": "coin" }] }
            }
          }
        }
      },
      "expected": { "outcome": "valid" }
    },
    {
      "id": "paperdoll-v3.resolve.nested-element",
      "rule": "paper-doll/v3#addressing",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": {
          "root": "torso",
          "vessels": {
            "torso": {
              "contains": [{
                "kind": "item",
                "id": "pack",
                "body": {
                  "root": "pocket",
                  "vessels": {
                    "pocket": { "contains": [{ "kind": "item", "id": "rope" }] }
                  }
                }
              }]
            }
          }
        },
        "address": "torso/pack/pocket/rope"
      },
      "expected": {
        "outcome": "resolved",
        "value": {
          "kind": "element",
          "vesselId": "pocket",
          "index": 0,
          "element": { "kind": "item", "id": "rope" }
        }
      }
    },
    {
      "id": "paperdoll-v3.resolve.root-vessel",
      "rule": "paper-doll/v3#addressing",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": { "root": "root", "vessels": { "root": {} } },
        "address": "root"
      },
      "expected": { "outcome": "resolved", "value": { "kind": "vessel", "vesselId": "root" } }
    },
    {
      "id": "paperdoll-v3.resolve.element-array-index",
      "rule": "paper-doll/v3#addressing",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": {
          "root": "root",
          "vessels": {
            "root": { "contains": [{ "kind": "item", "id": "first" }, { "kind": "item", "id": "second", "data": { "n": 2 } }] }
          }
        },
        "address": "root/second"
      },
      "expected": {
        "outcome": "resolved",
        "value": { "kind": "element", "vesselId": "root", "index": 1, "element": { "kind": "item", "id": "second", "data": { "n": 2 } } }
      }
    },
    {
      "id": "paperdoll-v3.resolve.negative-zero-data",
      "rule": "paper-doll/v3#equality",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": {
          "root": "root",
          "vessels": {
            "root": { "contains": [{ "kind": "item", "id": "offset", "data": -0 }] }
          }
        },
        "address": "root/offset"
      },
      "expected": {
        "outcome": "resolved",
        "value": { "kind": "element", "vesselId": "root", "index": 0, "element": { "kind": "item", "id": "offset", "data": 0 } }
      }
    },
