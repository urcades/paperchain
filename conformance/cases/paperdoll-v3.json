    {
      "id": "paperdoll-v3.validate.duplicate-local-element-id",
      "rule": "paper-doll/v3#law-8-identity",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": {
            "root": "root",
            "vessels": {
              "root": { "contains": [{ "kind": "item", "id": "coin" }, { "kind": "item", "id": "coin" }] }
            }
          }
        }
      },
      "expected": {
        "outcome": "invalid",
        "includesErrorPaths": ["$.body.vessels.root.contains.1.id"]
