        "address": "Root"
      },
      "expected": { "outcome": "error" }
    },
    {
      "id": "paperdoll-v3.resolve.malformed-empty-segment",
      "rule": "paper-doll/v3#addressing",
      "subject": "paper-doll/v3",
      "operation": "resolveAddress",
      "input": {
        "body": { "root": "root", "vessels": { "root": {} } },
        "address": "root//key"
      },
      "expected": { "outcome": "error" }
    },
    {
      "id": "paperdoll-v3.layout.normalized-figure-free-connections",
      "rule": "paper-doll/v3#layout",
      "subject": "paper-doll/v3",
      "operation": "deriveLayout",
      "input": {
        "body": {
          "root": "torso",
          "vessels": {
            "torso": { "ports": { "right": { "vessel": "arm", "side": "left" }, "top": { "vessel": "head", "side": "bottom" } } },
            "zeta": {},
            "head": { "ports": { "bottom": { "vessel": "torso", "side": "top" } } },
            "alpha": {},
            "arm": { "ports": { "left": { "vessel": "torso", "side": "right" } } }
          }
        }
      },
      "expected": {
        "outcome": "layout",
        "value": {
          "figure": { "torso": { "x": 0, "y": 0 }, "arm": { "x": 1, "y": 0 }, "head": { "x": 0, "y": -1 } },
          "free": ["alpha", "zeta"],
          "connections": [
            { "from": { "vessel": "arm", "side": "left" }, "to": { "vessel": "torso", "side": "right" } },
            { "from": { "vessel": "head", "side": "bottom" }, "to": { "vessel": "torso", "side": "top" } }
          ]
        }
      }
    }
  ]
}
