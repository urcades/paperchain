{
  "corpus": "paper-family-conformance/v1",
  "cases": [
    {
      "id": "paperdoll-v3.validate.minimal-valid",
      "rule": "paper-doll/v3#document-grammar",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": { "root": "root", "vessels": { "root": {} } }
        }
      },
      "expected": { "outcome": "valid" }
    },
    {
      "id": "paperdoll-v3.validate.unknown-document-key",
      "rule": "paper-doll/v3#document-grammar",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": { "root": "root", "vessels": { "root": {} } },
          "label": "extra"
        }
      },
      "expected": { "outcome": "invalid", "includesErrorPaths": ["$.label"] }
    },
    {
      "id": "paperdoll-v3.validate.missing-constructor-root",
      "rule": "paper-doll/v3#law-1-rootedness",
      "subject": "paper-doll/v3",
      "operation": "validateDocument",
      "input": {
        "document": {
          "protocol": "paper-doll/v3",
          "body": { "root": "constructor", "vessels": {} }
        }
      },
      "expected": { "outcome": "invalid", "includesErrorPaths": ["$.body.root"] }
    },
    {
      "id": "paperdoll-v3.validate.explicit-constructor-root",
      "rule": "paper-doll/v3#law-1-rootedness",
      "subject": "paper-doll/v3",
